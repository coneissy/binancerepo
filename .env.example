# Binance credentials: keep these in Render Environment, never commit secrets.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE=https://api.binance.com
BINANCE_FUTURES_API_BASE=https://fapi.binance.com

# Safe defaults. LIVE_TRADING, LIVE_ARMED and LIVE_CONFIRMATION must all be explicitly configured before any live executor can arm.
LIVE_TRADING=false
LIVE_ARMED=false
LIVE_CONFIRMATION=
LIVE_SPOT_TRADING=false
LIVE_FUTURES_TRADING=false

# Risk controls
LIVE_STARTING_BALANCE_USDT=30
ARB_RISK_PCT=0.005
MAX_LIVE_NOTIONAL_USDT=0.15
ARB_MIN_NET_BPS=5
MAX_MARKET_DATA_AGE_MS=500
BINANCE_RECV_WINDOW=5000
LIVE_ORDER_COOLDOWN_MS=5000

# Existing strategy/runtime settings
TOP_N=20
CHALLENGER_N=10
RANK_REFRESH_SECONDS=30
MAX_SIMULTANEOUS_POSITIONS=3
ENTRY_SCORE=0.78
CHALLENGER_GAP=0.06
MIN_24H_QUOTE_VOLUME=1000000
MIN_1M_QUOTE_VOLUME=50000
MAX_SPREAD_BPS=10
ENTRY_COOLDOWN_SECONDS=45
MAX_HOLD_SECONDS=180
EST_FEE_BPS=4
EST_SLIPPAGE_BPS=3
DRY_RUN=true
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
